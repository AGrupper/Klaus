# Application Settings
ENVIRONMENT=development # or production
TZ=Asia/Jerusalem

# Smart Agent — Gemini 3.5 Flash (the brain: orchestrates, judges, crafts responses)
SMART_AGENT_BACKEND=gemini
SMART_AGENT_MODEL=gemini-3.5-flash
SMART_AGENT_API_KEY=your_google_ai_studio_key

# Smart Agent Fallback (optional) — activates automatically if the primary is down.
# If all three vars are set, the orchestrator retries with this model on LLM errors.
SMART_AGENT_FALLBACK_BACKEND=anthropic
SMART_AGENT_FALLBACK_MODEL=claude-haiku-4-5
SMART_AGENT_FALLBACK_API_KEY=your_anthropic_api_key

# Worker Agent — DeepSeek V4 Flash (the hands: executes tools, does data gathering)
# API key is from DeepSeek (platform.deepseek.com). Uses OpenAI-compatible endpoint.
WORKER_AGENT_BACKEND=openai
WORKER_AGENT_MODEL=deepseek-v4-flash
WORKER_AGENT_API_KEY=your_deepseek_api_key
WORKER_AGENT_BASE_URL=https://api.deepseek.com/v1

# Telegram Bot Interface
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
# Your personal Telegram user ID — get it from @userinfobot. Comma-separated for multiple.
TELEGRAM_ALLOWED_USER_IDS=your_telegram_user_id

# Google Cloud OAuth & Firebase
GCP_PROJECT_ID=your_gcp_project_id
GOOGLE_APPLICATION_CREDENTIALS=./config/credentials.json
GOOGLE_TOKEN_PATH=./config/token.json

# Explicit socket-read timeout (seconds) for the Gmail/Calendar httplib2 client.
# Mirrors LLM_TIMEOUT_SECONDS — a stalled Google API socket read must fail fast
# rather than hang past the Cloud Run request deadline.
GOOGLE_API_TIMEOUT_SECONDS=30

# Memory Databases
PINECONE_API_KEY=your_pinecone_api_key
PINECONE_INDEX_NAME=klaus-memory
# Dedicated Gemini AI Studio credential for gemini-embedding-2. During the
# v7 rollout, SMART_AGENT_API_KEY remains a temporary fallback for embeddings.
GEMINI_EMBEDDING_API_KEY=your_google_ai_studio_key
# Operator-maintained public list rate used with provider-reported input tokens.
# Leave unset to report actual token/request counts without estimating cost.
GEMINI_EMBEDDING_COST_PER_MILLION_TOKENS=
KLAUS_EMBEDDING_METER_ENABLED=false
KLAUS_TRAINING_WRITEBACK_ENABLED=false

# Klaus v7 — subscription-first Claude interfaces. All ship dark. Prove the
# four capabilities in docs/CLAUDE_FIRST_USE.md before enabling cutover flags.
KLAUS_PUBLIC_URL=http://localhost:8080
CLAUDE_PROJECT_URL=
# Provider-neutral canonical user namespace. It must match the user_id metadata
# already stored in Pinecone; Telegram ID fallback is migration-only.
KLAUS_USER_ID=123456789
KLAUS_MCP_ENABLED=false
KLAUS_MCP_READ_ONLY_MODE=true
KLAUS_CLAUDE_LIVE_ENABLED=false
KLAUS_CLAUDE_ROUTINES_ENABLED=false
KLAUS_CAPABILITY_MCP_VERIFIED=false
KLAUS_CAPABILITY_SKILL_VERIFIED=false
KLAUS_CAPABILITY_ROUTINE_VERIFIED=false
KLAUS_CAPABILITY_PUBLISH_VERIFIED=false
KLAUS_ROUTINE_MORNING_CUTOVER=true
KLAUS_ROUTINE_NIGHTLY_CUTOVER=true
KLAUS_ROUTINE_WEEKLY_CUTOVER=true
KLAUS_DETERMINISTIC_ALERTS_ENABLED=true
KLAUS_HUB_CHAT_ENABLED=false
KLAUS_LEGACY_RUNTIME_ENABLED=false
KLAUS_OAUTH_REDIRECT_HOSTS=claude.ai,claude.com
CLAUDE_ROUTINE_TRIGGER_URL_MORNING=
CLAUDE_ROUTINE_TRIGGER_URL_NIGHTLY=
CLAUDE_ROUTINE_TRIGGER_URL_WEEKLY=
# Claude issues a different bearer token for each routine API trigger.
CLAUDE_ROUTINE_TRIGGER_TOKEN_MORNING=
CLAUDE_ROUTINE_TRIGGER_TOKEN_NIGHTLY=
CLAUDE_ROUTINE_TRIGGER_TOKEN_WEEKLY=
# Temporary rollout fallback only; prefer the three routine-specific variables.
CLAUDE_ROUTINE_TRIGGER_TOKEN=
CLAUDE_ROUTINE_TRIGGER_TIMEOUT_SECONDS=30

# Phase 6: Conversation persistence backend — "memory" for local dev, "firestore" for cloud
CONVERSATION_STORE=memory

# Number of hours of inactivity before a conversation session resets
SESSION_TIMEOUT_HOURS=6

# Firestore (conversation store, roster, attendance)
# Path to a service-account JSON with roles/datastore.user.
# Kept separate from GOOGLE_APPLICATION_CREDENTIALS (which is the OAuth client-secrets
# file used by Gmail/Calendar) — the two formats are incompatible with ADC.
FIRESTORE_CREDENTIALS=./config/firestore-service-account.json
FIRESTORE_DATABASE=your_firestore_database_name

# Task backend — Things 3 via Things Cloud (replaces TickTick and the Phase 4
# URL-scheme queue, both retired).
#
# Things Cloud account credentials. There is no API key or OAuth: Cultured Code
# publishes no API, so this speaks the reverse-engineered sync protocol
# documented in docs/things_protocol.md. Things Cloud has no 2FA, so this
# password grants full account access — keep it in Secret Manager.
THINGS_EMAIL=your_things_cloud_email
THINGS_PASSWORD=your_things_cloud_password

# Things is the sole task authority. Firestore remains a mirror/outbox during
# the soak and cannot be selected as a task-read or task-write fallback.
TASK_BACKEND=things

# Writes are OFF unless explicitly enabled. The protocol is unofficial and can
# break on any Things release; leave this false until writes are verified.
THINGS_WRITE_ENABLED=false

# Seconds between journal head-index checks on the read path (default 60).
THINGS_FRESHNESS_TTL_SECONDS=60

# Phase 5: Cloud Run deployment
# HTTP port (Cloud Run sets this automatically; 8080 is the default)
PORT=8080

# OAuth token storage backend: "file" (local dev) or "secret_manager" (Cloud Run)
GOOGLE_TOKEN_STORAGE=file

# Required when GOOGLE_TOKEN_STORAGE=secret_manager. Plain secret name (not full resource path).
# Example: GOOGLE_TOKEN_SECRET_NAME=klaus-google-oauth-token
GOOGLE_TOKEN_SECRET_NAME=

# Telegram webhook secret token — high-entropy random string that Telegram sends in
# X-Telegram-Bot-Api-Secret-Token on every webhook POST. Must match what you pass to
# setWebhook. Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
TELEGRAM_WEBHOOK_SECRET=

# Shared-secret bearer for the iOS Sleep-Focus automation that triggers the nightly
# review (POST /trigger/nightly). Dedicated token (not the HealthKit one) for least
# privilege. The route fails closed (500) if this is unset. Generate with:
# python -c "import secrets; print(secrets.token_urlsafe(32))"
NIGHTLY_TRIGGER_TOKEN=

# Shared-secret bearer for the iOS Sleep-Focus-OFF automation that triggers the
# morning briefing (POST /trigger/morning). A SEPARATE secret from
# NIGHTLY_TRIGGER_TOKEN (D-13 least privilege) — a leaked credential must not unlock
# both proactive surfaces. The route fails closed (500) if this is unset. Generate
# with: python -c "import secrets; print(secrets.token_urlsafe(32))"
MORNING_TRIGGER_TOKEN=

# Phase 33 (D-30): gates the nightly + weekly judgment-driven occasion cascade
# (core/nightly_review.py, core/weekly_training_review.py). Morning is cascade-only
# and is not gated by this flag. Ships false; flipped to true by an operator step
# (plan 33-13) after /trigger/morning is confirmed live.
OCCASION_CASCADE=false

# Design decision 2026-08-03: the autonomous tick (*/20 7-21) holds off
# speaking until today's morning briefing has reached a terminal status
# (sent/manual/skipped_by_judgment/skipped_by_directive), so the briefing
# owns the start of the day and the tick owns everything after. Backstop
# hour (local Asia/Jerusalem) at which the tick proceeds REGARDLESS of
# morning status — load-bearing: the iOS wake trigger not firing on a given
# day must cost a late start, never a silent day (same no-backstop trap as
# D-09). Declared here AND in .github/workflows/deploy.yml's --set-env-vars
# (that flag list clobbers out-of-band Cloud Run env vars).
TICK_MORNING_GATE_UNTIL_HOUR=11

# Phase 7: External connections — Garmin, Readwise, Weather

# Garmin Connect credentials (email/password — no OAuth available for Connect API)
GARMIN_EMAIL=your_garmin_email
GARMIN_PASSWORD=your_garmin_password

# Readwise API token — get from https://readwise.io/access_token
READWISE_TOKEN=your_readwise_token

# Hevy strength-training API key (Hevy Pro only) — sent as the `api-key` header.
# Generate at https://hevy.com/settings?developer. Powers the daily /cron/strength-sync
# pull into StrengthSessionStore (full per-set workout history).
HEVY_API_KEY=your_hevy_api_key

# Phase 8: Five Fingers cron endpoints (Cloud Scheduler → OIDC → Cloud Run)

# Cloud Run service URL — used as the OIDC token audience for /cron/* auth.
CLOUD_RUN_URL=

# Service account email that Cloud Scheduler uses to call /cron/* routes.
# Must match the SA attached to the Cloud Scheduler jobs.
CLOUD_SCHEDULER_SA_EMAIL=

# Set to "true" in local dev to skip OIDC verification on /cron/* routes.
CRON_DEV_BYPASS=false

# Phase 9: Proactive Alerts
PROACTIVE_RAIN_THRESHOLD=20          # Rain chance % that triggers weather alert
PROACTIVE_TEMP_MAX=38                # Celsius — flag extreme heat
PROACTIVE_TEMP_MIN=8                 # Celsius — flag extreme cold
PROACTIVE_FREE_TIME_MIN=60           # Minutes — total free time below this = overloaded
PROACTIVE_GAP_MIN=30                 # Minutes — longest gap below this = overloaded
HOME_ADDRESS=                        # Or store in Secret Manager as "klaus-home-address"

# Phase 11: Notion integration
# Create an internal integration at https://www.notion.so/my-integrations
# Share your PARA databases (Projects, Areas, Resources, Archives) with the integration
# The token does not expire — no refresh script needed
NOTION_API_TOKEN=your_notion_internal_integration_token
NOTION_JOURNAL_DB_ID=                 # optional — your journal/daily-log database ID for reliable append-to-journal workflows

# Phase 12: Claude Code chat-log ingestion
# GCS bucket where local upload scripts push raw JSONL files
CHAT_LOGS_BUCKET=                             # e.g. "klaus-chat-logs-your-project-id"
# Notion database ID for the chat-log summary table (one row per conversation)
# Create the DB manually: Name (title), Date (date), Project (select), Summary (rich_text),
# Topics (multi_select), Machine (select), Session ID (rich_text)
NOTION_CHAT_LOG_DB_ID=                        # your Notion chat-log database ID
# Optional tuning (defaults: 8 files, 45s)
CHAT_INGEST_BATCH_MAX_FILES=8
CHAT_INGEST_TIME_BUDGET_SEC=45

# Phase 13: Multi-source AI chat export ingestion (Claude.ai / ChatGPT / Gemini)
# Upload zips to GCS with: scripts/upload_chat_export.sh <provider> <zip>
# They land in gs://${CHAT_LOGS_BUCKET}/chat-exports/{claude_ai,chatgpt,gemini}/
# Notion database ID for "Klaus AI Chat Imports" (one row per conversation)
# Create the DB manually: Name (title), Date (date), Source (select: claude_ai/chatgpt/gemini),
# Summary (rich_text), Topics (multi_select), Message Count (number),
# Conversation ID (rich_text — upsert key), Last Updated (date)
NOTION_AI_CHAT_DB_ID=                         # your "Klaus AI Chat Imports" Notion DB ID
# Optional tuning (defaults: 20 conversations, 45s)
CHAT_EXPORT_BATCH_MAX_CONVERSATIONS=20
CHAT_EXPORT_TIME_BUDGET_SEC=45

# Phase 14: Self-monitoring heartbeat
# GitHub repo "owner/name" for the deploy-status check (e.g. amitgrupper/Klaus).
KLAUS_GITHUB_REPO=
# Fine-grained GitHub read token (Actions: read). On Cloud Run this is injected
# from Secret Manager secret "klaus-github-token"; set inline only for local dev.
KLAUS_GITHUB_TOKEN=
# Optional dead-man's-switch: a healthchecks.io ping URL hit at the end of a
# successful tick. Leave blank to disable.
HEARTBEAT_DEADMAN_URL=

# Phase 14: Tick-Brain (Groq/GPT-OSS-120B free reasoning layer)
# Sign up at https://console.groq.com — free tier, no training on data.
# Store TICK_BRAIN_API_KEY in GCP Secret Manager as "TICK_BRAIN_API_KEY" (INFRA-02).
# Run: gcloud secrets create TICK_BRAIN_API_KEY --replication-policy automatic
#      echo -n "gsk_..." | gcloud secrets versions add TICK_BRAIN_API_KEY --data-file=-
TICK_BRAIN_BACKEND=openai
# NOTE: Groq model ids are namespaced — bare model names return 404 model_not_found.
# qwen/qwen3-32b was decommissioned by Groq on 2026-07-17; gpt-oss-120b replaces it.
TICK_BRAIN_MODEL=openai/gpt-oss-120b
TICK_BRAIN_API_KEY=your_groq_api_key
TICK_BRAIN_BASE_URL=https://api.groq.com/openai/v1
# Completion budget per call. Groq's free tier counts input + max_tokens
# against the per-request TPM limit (8K for gpt-oss-120b) — the global default
# of 4096 leaves too little input headroom (413) and silently re-routes every
# call to the metered fallback. gpt-oss-120b also caps 200K tokens/DAY.
TICK_BRAIN_MAX_TOKENS=2048
# Sampling temperature. The provider default (~1.0) makes the judgment gate
# flip on borderline ticks run-to-run; 0.6 tames verdict flapping.
TICK_BRAIN_TEMPERATURE=0.6

# Phase 29: Web Push (Klaus Hub PWA)
# VAPID public key (base64url) — the frontend passes it to pushManager.subscribe
# as applicationServerKey. Generate the keypair once with `vapid --gen`, then
# print this value with `vapid --applicationServerKey`. The PRIVATE key is NEVER
# an env var — it lives only in Secret Manager secret "klaus-vapid-private-key"
# (lowercase klaus- — uppercase causes silent 404s). See docs/DEPLOYMENT.md §27.
VAPID_PUBLIC_KEY=your_vapid_public_key_base64url
